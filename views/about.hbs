{{> menu id="about"}}

<section class="ui segment about-page">
  <h1 class="ui header">About</h1>

  <div class="about-grid">
    <div class="ui segment about-card contact-card">
      <h3 class="ui header">Contact Details</h3>
      <p>Aurthor / Company</p>
      <p><strong>Company:</strong> A.R Aviation Analytics </p>
      <p><strong>Author:</strong> A.R</p>
      <p><strong>Email:</strong> contact@ar-aviation.test</p>
      <p><strong>Phone:</strong> +353 01 234 5678</p>
      <p><strong>Address:</strong> 1 Aviation Way, Waterford, Ireland</p>
    </div>

    <div class="ui segment about-card location-card">
      <h3 class="ui header">Location</h3>
      <p>Waterford</p>
      <div class="zoom-wrap about-map">
        <img src="/map.png" alt="Location map">
      </div>
      <p>Based in: Waterford</p>
    </div>
  </div>

  <div class="ui segment about-card stats-card">
    <h3 class="ui header">App Statistics</h3>
    <p class="stats-sub">Live totals</p>

    <div class="stats-grid">
      <div>
        <p><strong>Total categories</strong></p>
        <h2>{{totalCategories}}</h2>
      </div>

      <div>
        <p><strong>Total items</strong></p>
        <h2>{{totalItems}}</h2>
      </div>
    </div>
  </div>

  <div class="about-bottom">
    <div class="icon-row">
      <div class="icon-block">
        <i class="big plane icon"></i>
        <p><strong>APP TITLE:</strong><br>Military Technology Atlas</p>
      </div>

      <div class="icon-block">
        <i class="big code branch icon"></i>
        <p><strong>APP VERSION:</strong><br>CA1 / CA2</p>
      </div>

      <div class="icon-block">
        <i class="big map marker alternate icon"></i>
        <p><strong>MADE IN:</strong><br>Waterford</p>
      </div>

      <div class="icon-block">
        <i class="big user icon"></i>
        <p><strong>CREATED BY:</strong><br>A.R</p>
      </div>

      <div class="icon-block">
        <i class="big handshake icon"></i>
        <p><strong>WITH HELP FROM:</strong><br>MARY LYNG</p>
      </div>
    </div>
  </div>

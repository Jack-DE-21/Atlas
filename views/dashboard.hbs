<section class="ui segment">
  <h2 class="title">Dashboard</h2>

  <form action="/sortData" method="GET" class="ui form search-form">
    <div class="ui inline fields">
      <div class="field">
        <input type="text" name="searchTerm" placeholder="Search by title..." value="{{search}}">
      </div>

      <div class="field">
        <label>Sort by:</label>
        <select class="ui dropdown" name="sort" onchange="this.form.submit()">
          <option value="title" {{#if titleSelected}}selected{{/if}}>Title</option>
          <option value="rating" {{#if ratingSelected}}selected{{/if}}>Rating</option>
        </select>
      </div>

      <div class="field">
        <label>Order:</label>
        <select class="ui dropdown" name="order" onchange="this.form.submit()">
          <option value="asc" {{#if ascSelected}}selected{{/if}}>↑</option>
          <option value="desc" {{#if descSelected}}selected{{/if}}>↓</option>
        </select>
      </div>
    </div>
  </form>
</section>

<section class="ui segment">
  <h3 class="ui header">Add Category</h3>

  <form class="ui form" action="/dashboard/addcategory" method="POST">
    <div class="two fields">
      <div class="field">
        <label>Category Title</label>
        <input type="text" name="title" placeholder="Enter category title" required>
      </div>

      <div class="field">
        <label>Rating</label>
        <input type="range" name="rating" min="1" max="5" value="3">
      </div>
    </div>

    <button class="ui violet button" type="submit">
      Add Category
    </button>
  </form>
</section>

<section class="ui segment">
  {{#each categories}}
    <div class="ui segment">
      <h3 class="ui header">{{uppercase title}}</h3>

      <p>
        <i class="sitemap icon"></i>
        Total systems: {{items.length}}

        {{#if date}}
          <br />
          <i class="calendar alternate outline icon"></i>
          Created on <i>{{formatDate date}}</i>
        {{/if}}
      </p>

      {{#if rating}}
        <p>
          <span
            class="ui yellow disabled rating"
            data-icon="star"
            data-rating="{{rating}}"
            data-max-rating="5">
          </span>

          <span style="color: grey; font-size: 90%; font-style: italic">
            {{highlightPopular rating}}
          </span>
        </p>
      {{/if}}

      <a class="ui icon button" href="/category/{{id}}" title="Open {{title}}">
        <i class="folder open outline icon"></i>
      </a>

      <a class="ui icon button" href="/dashboard/deletecategory/{{id}}" title="Delete {{title}}">
        <i class="trash violet icon"></i>
      </a>
    </div>
  {{/each}}
</section>
<section class="ui segment">
  <h2 class="ui header">Dashboard</h2>

  {{#each categories}}
    <div class="ui segment">
      <h3 class="ui header">{{title}}</h3>
      <p>Total systems: {{items.length}}</p>

      <a class="ui icon button" href="/category/{{id}}" title="Open {{title}}">
        <i class="folder open outline icon"></i>
      </a>

      <a class="ui icon button" href="/dashboard/deletecategory/{{id}}" title="Delete {{title}}">
        <i class="trash black icon"></i>
      </a>
    </div>
  {{/each}}
</section>


<section class="ui segment">
  <h3 class="ui header">Add Category</h3>

  <form class="ui form" action="/dashboard/addcategory" method="POST">
    <div class="field">
      <label>Category Title</label>
      <input type="text" name="title" placeholder="Enter category title" required>
    </div>

    <button class="ui green button" type="submit">
      Add Category
    </button>
  </form>
</section>
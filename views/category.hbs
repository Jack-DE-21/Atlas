<section class="ui segment">
  <h2 class="ui header">{{category.title}}</h2>

  {{#if category.items.length}}

    <table class="ui unstackable striped table">
      <thead>
        <tr>
          <th class="four wide">Name</th>
          <th class="four wide">Role</th>
          <th class="two wide"> </th>
          <th class="two wide"> </th>
        </tr>
      </thead>
      <tbody>
        {{#each category.items}}
          {{> listOneItem categoryId=../category.id itemIndex=@index}}
          {{> edititem categoryId=../category.id itemIndex=@index}}

          <script>
  document.querySelector("#showEdit{{@index}}").addEventListener("click", () => {
    document.querySelector("#item{{@index}}").style.display = "none";
    document.querySelector("#edit{{@index}}").style.display = "table-row";
  });

  document.querySelector("#hideEdit{{@index}}").addEventListener("click", () => {
    document.querySelector("#item{{@index}}").style.display = "table-row";
    document.querySelector("#edit{{@index}}").style.display = "none";
  });
</script>
        {{/each}}
      </tbody>
    </table>

  {{else}}
    <h3 class="ui message">
      Empty category.
    </h3>
  {{/if}}

  <form class="ui form" action="/category/{{category.id}}/additem" method="POST">
    <div class="two fields">
      <div class="field">
        <label>Name</label>
        <input type="text" name="name" placeholder="Name" required>
      </div>
      <div class="field">
        <label>Role</label>
        <input type="text" name="role" placeholder="Role" required>
      </div>
    </div>

    <button class="ui violet button" type="submit">Add</button>
  </form>
</section>
<section class="ui segment">
  <h2 class="ui header">{{category.title}}</h2>

  {{#if category.items.length}}
    <table class="ui celled table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Role</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each category.items}}
          <tr>
            <td>{{name}}</td>
            <td>{{role}}</td>
            <td class="center aligned">
              <a href="/category/{{../category.id}}/deleteitem/{{id}}" title="Delete item">
                <i class="ui vioilet trash icon"></i>
              </a>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <p>Empty category.</p>
  {{/if}}

  <form class="ui form" action="/category/{{category.id}}/additem" method="POST">
    <div class="two fields">
      <div class="field">
        <label>Name</label>
        <input type="text" name="name" placeholder="Name" required>
      </div>
      <div class="field">
        <label>Role</label>
        <input type="text" name="role" placeholder="Role" required>
      </div>
    </div>

    <button class="ui violet button" type="submit">Add System</button>
  </form>
</section>
